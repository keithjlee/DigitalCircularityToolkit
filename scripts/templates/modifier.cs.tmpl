using System;
using DigitalCircularityToolkit.Framework;
using DigitalCircularityToolkit.Objects;
using Grasshopper.Kernel;
using Rhino.Geometry;

namespace __NAMESPACE__
{
    /// <summary>__DESC__</summary>
    /// <remarks>Modifier contract (docs/specs/MODIFIER_SPEC.md): object in -> NEW object of the SAME concrete type out;
    /// the input instance is never mutated.</remarks>
    public class __CLASS__ : DctComponent
    {
        public __CLASS__()
          : base("__NAME__", "__NICK__", "__DESC__", "__SUBCAT__")
        {
        }

        protected override void RegisterInputParams(GH_InputParamManager pManager)
        {
            pManager.AddGenericParameter("Object", "Obj", "Design object to modify", GH_ParamAccess.item);
            // add modifier parameters here
        }

        protected override void RegisterOutputParams(GH_OutputParamManager pManager)
        {
            pManager.AddGenericParameter("Object", "Obj", "Modified design object (same type as the input)", GH_ParamAccess.item);
        }

        protected override void SolveInstance(IGH_DataAccess DA)
        {
            DesignObject input = null;
            if (!DA.GetData(0, ref input) || input == null) return;

            // 1. Copy first: Grasshopper passes the SAME instance to every downstream component.
            DesignObject result = input.ShallowCopy();   // runtime type preserved: LinearObject stays LinearObject

            // 2. Replace fields on the copy. Never call Transform() on result.Geometry etc. in place:
            //    the copy still shares those reference objects with the input. Duplicate, then transform.

            DA.SetData(0, result);
        }

        // Generated by scripts/new-component.sh. Never change after release.
        public override Guid ComponentGuid => new Guid("__GUID__");

        public override GH_Exposure Exposure => GH_Exposure.__EXPOSURE__;
    }
}
