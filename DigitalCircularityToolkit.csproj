<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <!-- One cross-platform build for Rhino 8 (Windows + Mac, SR14+) and Rhino 9. net8.0 rolls forward onto the .NET 10
         runtime of Rhino 8.36+ and Rhino 9. net48 (Rhino 7) was dropped after the v0.5.x line (P2); net8.0-windows was
         never shipped. WinForms types (System.Drawing icons) come from the framework reference below. -->
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <!-- CA1416: System.Drawing is Windows-only in .NET, but Rhino provides it on macOS too (icons). -->
    <NoWarn>NU1701;NETSDK1086;CA1416</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  
    <PropertyGroup>
      <!-- Specifies information for Assembly and Yak -->
      <Version>0.5.2</Version>
      <Title>DigitalCircularityToolkit</Title>
      <Company>DigitalCircularityToolkit Authors</Company>
      <Description>Inventory-driven / circular structural design for Grasshopper: abstraction, characterization, distance matrices and optimal assignment of reclaimed objects.</Description>
    </PropertyGroup>
  
  <ItemGroup>
    <!-- Deliberately pinned to an old 8.x SR: a plugin will not load in a Rhino older than the SDK it references.
         Bump only when a newer API is actually needed. -->
    <PackageReference Include="Grasshopper" Version="8.14.24345.15001" IncludeAssets="compile;build" />
    <PackageReference Include="HungarianAlgorithm" Version="2.3.9" />
    <PackageReference Include="LapjvCSharp" Version="1.0.2" />
    <PackageReference Include="MIConvexHull" Version="1.2.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>
  
