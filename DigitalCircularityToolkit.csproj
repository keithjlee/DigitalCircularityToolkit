<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net7.0, net7.0-windows, net7.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net7.0, net7.0-macos, net7.0-macos12.0, etc
        Rhino 8.20+ / Rhino 9: net8.0 (rolls forward onto the .NET 10 runtime used by Rhino 8.36+ and Rhino 9)
    -->
    <TargetFrameworks>net8.0-windows;net8.0;net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  
    <PropertyGroup>
      <!-- Specifies information for Assembly and Yak -->
      <Version>1.0</Version>
      <Title>DigitalCircularityToolkit</Title>
      <Company>DigitalCircularityToolkit Authors</Company>
      <Description>Description of DigitalCircularityToolkit</Description>
    </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Accord.Statistics" Version="3.8.0" />
    <!-- Deliberately pinned to an old 8.x SR: a plugin will not load in a Rhino older than the SDK it references.
         Bump only when a newer API is actually needed. -->
    <PackageReference Include="Grasshopper" Version="8.14.24345.15001" IncludeAssets="compile;build" />
    <PackageReference Include="HungarianAlgorithm" Version="2.3.9" />
    <PackageReference Include="LapjvCSharp" Version="1.0.2" />
    <PackageReference Include="MIConvexHull" Version="1.2.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>
  
