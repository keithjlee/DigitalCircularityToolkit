    <!-- For Windows only builds -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4'))">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Reference WinForms (System.Drawing etc.) for the cross-platform net8.0 build (Rhino 8.11+) -->
  <ItemGroup Condition="!($(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4')))">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <!-- Side projects (benchmarks etc.) live under tools/ and must not be globbed into the plugin -->
  <ItemGroup>
    <Compile Remove="tools/**;tests/**" />
    <None Remove="tools/**;tests/**" />
    <EmbeddedResource Remove="tools/**;tests/**" />
  </ItemGroup>

  <!-- Icons by convention (new components, see docs/DEV_WORKFLOW.md):
       Icons/<ClassName>.svg|.pdf  ->  Resources/Icons/<ClassName>.png (generated, committed)  ->  embedded. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.png" />
  </ItemGroup>

  <!-- Render changed icon sources before resources are collected. Runs in the outer multi-TFM build (inner
       builds then find the PNGs up to date) and in single-TFM builds (-f). Skipped on Windows: PNGs are committed. -->
  <Target Name="GenerateIcons" BeforeTargets="DispatchToInnerBuilds;PrepareForBuild" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/scripts/icons.sh&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="Resources\Icons\*.png" Exclude="@(EmbeddedResource)" />
    </ItemGroup>
  </Target>

